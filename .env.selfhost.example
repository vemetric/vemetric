# Image version to run. install.sh replaces this with the current release tag (without the
# leading v). For a manual install, put a fixed version here yourself: `latest` floats, so an
# unattended pull can cross a release with a breaking migration without any warning.
VEMETRIC_VERSION=latest

# Public origins. Caddy terminates TLS and requests certificates automatically for https origins.
# A self hosted domain can have any number of labels, so the frontend cannot derive the other
# origins from the browser location. The app container reads these three and hands them to the
# frontend when it serves the dashboard, so changing them only requires a restart, no rebuild.
DOMAIN=vemetric.localhost
# Dashboard and API. Required, used for OAuth callbacks and invitation links.
APP_ORIGIN=http://app.vemetric.localhost
# Event ingestion endpoint the SDKs talk to. Required.
HUB_ORIGIN=http://hub.vemetric.localhost
# Bare domain, redirects to the dashboard. Optional. Leave it empty to not serve the bare
# domain at all, which needs no DNS record for it. A value equal to APP_ORIGIN is ignored.
ROOT_ORIGIN=http://vemetric.localhost
ACME_EMAIL=admin@example.com

# Billing, plans and usage are disabled on self hosted instances, which always run with the
# full feature set. This is set by docker-compose.selfhost.yml and needs no entry here.

# Registration. With "false" only the very first account can be created through the signup
# screen, every later signup is rejected unless it comes through a valid invitation link.
# Invitation links are single use and expire after 7 days, so keep this at "false" when
# onboarding teammates. See "Inviting team members" in docs/self-hosting.md.
# Creating the first account through the signup screen requires a working SMTP server for the
# verification mail. The bootstrap script in docs/self-hosting.md creates it without one.
ALLOW_REGISTRATION=false

# Auth. BETTER_AUTH_URL has to match APP_ORIGIN.
BETTER_AUTH_URL=http://app.vemetric.localhost
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
EMAIL_TOKEN_SECRET=replace-with-openssl-rand-hex-32

# Social login. Optional, leave all four empty to offer email and password only.
# A provider is enabled when both its client id and secret are set, setting only one of the two
# makes the app refuse to start. Callback URLs to register with the provider:
#   GitHub: <APP_ORIGIN>/_api/auth/callback/github
#   Google: <APP_ORIGIN>/_api/auth/callback/google
# ALLOW_REGISTRATION applies to social signups as well.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres
POSTGRES_USER=vemetric
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=vemetric

# ClickHouse
CLICKHOUSE_USER=vemetric
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DB=vemetric

# Redis
REDIS_PASSWORD=replace-me

# Mail. Use "smtp" for self hosted setups, "postmark" for a Postmark account.
# Optional: with an empty SMTP_HOST no mail is sent. Only password resets
# need a mail server, the administrator account created by the bootstrap script does not.
MAIL_PROVIDER=smtp
# Required once SMTP_HOST is set. Use a domain your SMTP server may send for (SPF/DMARC).
MAIL_FROM_ADDRESS=Vemetric <vemetric@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to false only for internal relays with self signed certificates.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Only needed when MAIL_PROVIDER=postmark
POSTMARK_SERVER_API_TOKEN=
POSTMARK_TRANSACTIONAL_MESSAGE_STREAM_ID=outbound

# Queue dashboard, only started with: --profile debug
BULLBOARD_USERNAME=bullboard
BULLBOARD_PASSWORD=replace-me
